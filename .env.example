# --- Twilio credentials (from https://console.twilio.com) ---
# Leave SID empty while you don't have an account — the app runs fine without it.
TWILIO_ACCOUNT_SID=
# local-dev-token signs simulated webhooks so validation works with no account.
# Replace with your real Auth Token when you go live.
TWILIO_AUTH_TOKEN=local-dev-token
TWILIO_PHONE_NUMBER=+15555550100

# true  -> outbound SMS is logged, not sent (safe local dev)
# false -> real sends via the Twilio API (needs real credentials above)
MOCK_MODE=true

# The URL Twilio "called" — signatures are verified against this.
# Locally: http://localhost:8000. With a tunnel: your public URL,
# e.g. https://abcd1234.ngrok-free.app
APP_BASE_URL=http://localhost:8000
